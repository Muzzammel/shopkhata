# ShopKhata environment variables. Names only: never put a real value in this file.
# Full explanation: docs/operations/environment.md

# --- Browser-safe (compiled into the browser bundle; required to build and to start) ---
# The Supabase project URL, for example https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. NEVER the service-role / secret key: the build refuses it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Deployment-only (set in the hosting settings, not needed locally) ---
# Hosting must set production. Use local only for a local production-build/PWA rehearsal.
# SHOPKHATA_ENV=production
# Optional fallback release tag for /api/health; Vercel's own VERCEL_GIT_COMMIT_SHA wins when present.
# SHOPKHATA_RELEASE=
# Set to true only once the site is served over HTTPS on its final domain.
# SHOPKHATA_ENABLE_HSTS=

# --- Operator-only (set in the shell for one backup or restore session; never in a file,
#     never in the hosting settings, never with a NEXT_PUBLIC_ prefix) ---
# SHOPKHATA_BACKUP_ENV=
# SHOPKHATA_BACKUP_DB_URL=
# SHOPKHATA_BACKUP_SUPABASE_URL=
# SHOPKHATA_BACKUP_SERVICE_ROLE_KEY=
# SHOPKHATA_BACKUP_DIR=
# SHOPKHATA_RESTORE_SUPABASE_URL=
# SHOPKHATA_RESTORE_SERVICE_ROLE_KEY=
