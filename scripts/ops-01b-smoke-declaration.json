{
  "about": "OPS-01B W11 operator smoke, record by record (runbook W12/W15). Fill every double-braced placeholder with --set NAME=value. Amounts are in fils (AED 100.00 = 10000). If S2 is not voided, delete the VOID, VOID_CORRECTION and invoice.void records.",
  "records": [
    { "as": "S1", "table": "invoices", "op": "insert", "match": { "invoice_id": "{{S1_NUMBER}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "total_amount_dirham": "{{S1_TOTAL}}", "created_by": "{{OWNER_ID}}" } },
    { "as": "S1_BATCH", "table": "batches", "op": "insert", "match": { "id": "@S1.batch_id", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}" } },
    { "table": "invoice_number_registry", "op": "insert", "match": { "canonical_invoice_id": "@S1.id", "invoice_number": "{{S1_NUMBER}}", "shop_id": "{{SHOP_ID}}" } },
    { "as": "S2", "table": "invoices", "op": "insert", "match": { "invoice_id": "{{S2_NUMBER}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "total_amount_dirham": "{{S2_TOTAL}}", "created_by": "{{OWNER_ID}}" } },
    { "as": "S2_BATCH", "table": "batches", "op": "insert", "match": { "id": "@S2.batch_id", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}" } },
    { "table": "invoice_number_registry", "op": "insert", "match": { "canonical_invoice_id": "@S2.id", "invoice_number": "{{S2_NUMBER}}", "shop_id": "{{SHOP_ID}}" } },
    { "as": "PAYMENT", "table": "payments", "op": "insert", "match": { "invoice_id": "@S1.id", "amount_dirham": "{{PAYMENT_AMOUNT}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}" } },
    { "as": "VOID", "table": "invoice_voids", "op": "insert", "match": { "invoice_id": "@S2.id", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "actor_user_id": "{{OWNER_ID}}" } },
    { "as": "VOID_CORRECTION", "table": "corrections", "op": "insert", "match": { "id": "@VOID.correction_id", "invoice_id": "@S2.id", "amount_delta_dirham": "-{{S2_TOTAL}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}" } },
    { "table": "audit_events", "op": "insert", "match": { "action": "batch.submit", "entity_id": "@S1_BATCH.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}" } },
    { "table": "audit_events", "op": "insert", "match": { "action": "batch.submit", "entity_id": "@S2_BATCH.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}" } },
    { "table": "audit_events", "op": "insert", "match": { "action": "record_payment", "entity_id": "@PAYMENT.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}" } },
    { "table": "audit_events", "op": "insert", "match": { "action": "invoice.void", "entity_id": "@S2.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}" } }
  ]
}
