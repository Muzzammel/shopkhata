{
  "about": "OPS-01B W11 operator smoke, record by record (runbook W12/W15). Fill every double-braced placeholder with --set NAME=value. Amounts are in fils (AED 100.00 = 10000). Every MATERIAL column of every record is pinned (scripts/window-compare.mjs MATERIAL): S1 and S2 are single-row advance sales (quantity 1, no customer, not delivered, no note, no payment in the batch), the payment is a cash payment on S1, S2 is voided with reason VOID_REASON. If the smoke differs, change these values, never drop a field. If S2 is not voided, delete the VOID_CORRECTION, VOID and invoice.void records.",
  "records": [
    { "as": "S1", "table": "invoices", "op": "insert", "match": { "invoice_id": "{{S1_NUMBER}}", "shop_id": "{{SHOP_ID}}", "batch_id": "@>S1_BATCH.id", "customer_id": null, "invoice_type": "advance", "quantity": "1", "total_amount_dirham": "{{S1_TOTAL}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}", "delivered": false, "note": null } },
    { "as": "S1_BATCH", "table": "batches", "op": "insert", "match": { "id": "@S1.batch_id", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "is_backdated": false, "backdated_reason": null, "created_by": "{{OWNER_ID}}" } },
    { "table": "invoice_number_registry", "op": "insert", "match": { "canonical_invoice_id": "@S1.id", "invoice_number": "{{S1_NUMBER}}", "shop_id": "{{SHOP_ID}}" } },
    { "as": "S2", "table": "invoices", "op": "insert", "match": { "invoice_id": "{{S2_NUMBER}}", "shop_id": "{{SHOP_ID}}", "batch_id": "@>S2_BATCH.id", "customer_id": null, "invoice_type": "advance", "quantity": "1", "total_amount_dirham": "{{S2_TOTAL}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}", "delivered": false, "note": null } },
    { "as": "S2_BATCH", "table": "batches", "op": "insert", "match": { "id": "@S2.batch_id", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "is_backdated": false, "backdated_reason": null, "created_by": "{{OWNER_ID}}" } },
    { "table": "invoice_number_registry", "op": "insert", "match": { "canonical_invoice_id": "@S2.id", "invoice_number": "{{S2_NUMBER}}", "shop_id": "{{SHOP_ID}}" } },
    { "as": "PAYMENT", "table": "payments", "op": "insert", "match": { "invoice_id": "@S1.id", "amount_dirham": "{{PAYMENT_AMOUNT}}", "payment_method": "cash", "batch_id": null, "customer_payment_batch_id": null, "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}" } },
    { "as": "VOID_CORRECTION", "table": "corrections", "op": "insert", "match": { "invoice_id": "@S2.id", "payment_id": null, "request_id": null, "amount_delta_dirham": "-{{S2_TOTAL}}", "reason": "{{VOID_REASON}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "created_by": "{{OWNER_ID}}", "approved_by": "{{OWNER_ID}}" } },
    { "as": "VOID", "table": "invoice_voids", "op": "insert", "match": { "invoice_id": "@S2.id", "correction_id": "@VOID_CORRECTION.id", "reason": "{{VOID_REASON}}", "shop_id": "{{SHOP_ID}}", "business_date": "{{BUSINESS_DATE}}", "actor_user_id": "{{OWNER_ID}}" } },
    { "table": "audit_events", "op": "insert", "match": { "action": "batch.submit", "entity_type": "batch", "entity_id": "@S1_BATCH.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}", "reason": null, "metadata": { "row_count": "1" } } },
    { "table": "audit_events", "op": "insert", "match": { "action": "batch.submit", "entity_type": "batch", "entity_id": "@S2_BATCH.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}", "reason": null, "metadata": { "row_count": "1" } } },
    { "table": "audit_events", "op": "insert", "match": { "action": "record_payment", "entity_type": "payment", "entity_id": "@PAYMENT.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}", "reason": null, "metadata": { "invoice_id": "@S1.id", "amount_dirham": "{{PAYMENT_AMOUNT}}", "business_date": "{{BUSINESS_DATE}}", "is_backdated": false } } },
    { "table": "audit_events", "op": "insert", "match": { "action": "invoice.void", "entity_type": "invoice", "entity_id": "@S2.id", "shop_id": "{{SHOP_ID}}", "actor_id": "{{OWNER_ID}}", "reason": "{{VOID_REASON}}", "metadata": { "invoice_id": "@S2.id", "original_invoice_number": "{{S2_NUMBER}}", "original_total_dirham": "{{S2_TOTAL}}", "effective_total_before_dirham": "{{S2_TOTAL}}", "paid_before_dirham": "0", "original_business_date": "{{BUSINESS_DATE}}", "void_business_date": "{{BUSINESS_DATE}}", "correction_id": "@VOID_CORRECTION.id", "void_id": "@VOID.id", "reason": "{{VOID_REASON}}", "actor": "{{OWNER_ID}}" } } }
  ]
}
